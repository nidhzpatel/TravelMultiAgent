# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Optional web search key (get yours at https://serper.dev)
SERPER_API_KEY=

# Optional live inventory aggregators for the v2 provider boundary.
# When absent in production, the capability is explicitly UNAVAILABLE.
FLIGHT_PROVIDER_URL=
FLIGHT_PROVIDER_TOKEN=
HOTEL_PROVIDER_URL=
HOTEL_PROVIDER_TOKEN=

# Gemini (primary LLM). Falls back to Ollama when rate-limited.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
